# Copy to .env for local use. In GitHub, add these under
# Settings → Secrets and variables → Actions.

# --- Affiliate IDs (added to product links automatically) ---
AMAZON_ASSOCIATE_TAG=
FLIPKART_AFFILIATE_ID=

# --- Product feed APIs (enable daily auto-import) ---
FLIPKART_AFFILIATE_TOKEN=
CUELINKS_API_KEY=

# --- Ads (leave empty until AdSense approves your domain) ---
PUBLIC_ADSENSE_CLIENT=
